<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 既定ホームでない状態でもアプリ一覧を取れるように、LAUNCHER アクティビティへの可視性を宣言する -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 下スワイプで開く端末の検索。Galaxy の Finder を優先し、無ければ全体検索(#29) -->
        <intent>
            <action android:name="android.search.action.GLOBAL_SEARCH" />
        </intent>
        <package android:name="com.samsung.android.app.galaxyfinder" />
    </queries>

    <!-- ドロワーの絞り込み(最近、よく使う)のための使用状況アクセス。設定画面でユーザーが許可する -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 長押しメニューの UNINSTALL(#36)。Android 9 以降、ACTION_DELETE を投げるのに要る。確認画面は端末側が出す -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- タスクバー(#56)。開いた画面で他のアプリの上にドックを重ねる。設定画面からユーザーが許可する -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fold8Launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- タスクバー(#55)。前面のアプリと画面の開閉を知るためのユーザー補助サービス。端末設定でユーザーが有効にする -->
        <service
            android:name=".taskbar.TaskbarService"
            android:exported="true"
            android:label="@string/taskbar_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/taskbar_accessibility" />
        </service>
    </application>
</manifest>
